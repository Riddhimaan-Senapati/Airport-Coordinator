{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-perf", "jsx-a11y", "nextjs", "import", "unicorn"],
  "options": {
    "typeAware": true
  },
  "rules": {
    "typescript/no-floating-promises": "error"
  },
  "ignorePatterns": [".next/**", "node_modules/**", "coverage/**"]
}
